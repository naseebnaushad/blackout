pkgname=blackout
pkgver=0.2.1
pkgrel=1
pkgdesc='OLED screen curtain, LayerOverlay key-combo lock, and OLED care utility'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'layer-shell-qt' 'brightnessctl' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/blackout "$pkgdir/usr/bin/blackout"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/blackout.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/blackout.svg"
  install -Dm644 "$startdir/blackout.desktop" "$pkgdir/usr/share/applications/blackout.desktop"
}
